<UserControl x:Class="Centesimo.Desktop.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Centesimo.Desktop.Controls">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Categorie e budget" Style="{StaticResource H1}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E5556E"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Categorie -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Nuova categoria" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Scegliendo una categoria padre crei una sotto-categoria (es. Alimentari → Supermercato)." />
                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" ctrl:Hint.Text="Nome" />

                    <ComboBox ItemsSource="{Binding CategoryTypes}" SelectedItem="{Binding NewCategoryType}" ctrl:Hint.Text="Tipo" />

                    <ComboBox ItemsSource="{Binding PossibleParents}" SelectedItem="{Binding NewCategoryParent}"
                              DisplayMemberPath="Name" ctrl:Hint.Text="Categoria padre (facoltativa)" />

                    <Button Content="Crea categoria" Command="{Binding AddCategoryCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Elenco categorie" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Categories}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Width="*" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Header="Tipo" Width="90" Binding="{Binding Type}" />
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Archivia" Padding="6,2" FontSize="11"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.ArchiveCategoryCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Budget -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Limite di spesa mensile" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Un solo budget corrente per categoria. Il consumo include le sotto-categorie." />
                    <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding BudgetCategory}"
                              DisplayMemberPath="DisplayName" ctrl:Hint.Text="Categoria" />

                    <TextBox Text="{Binding BudgetLimit, UpdateSourceTrigger=PropertyChanged}" ctrl:Hint.Text="Limite mensile (EUR)" />

                    <Button Content="Imposta budget" Command="{Binding AddBudgetCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Budget attivi" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Budgets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Rimuovi" Padding="6,2" FontSize="11"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.DeleteBudgetCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <ProgressBar Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding UsagePercent, Mode=OneWay}"
                                                 Foreground="{Binding OverBudget, Converter={StaticResource OverBudgetToBrush}}"
                                                 Background="{StaticResource SurfaceAltBrush}" BorderThickness="0" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"
                                                   Text="{Binding Remaining, StringFormat=residuo {0:N2} EUR}" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding SpentThisMonth, Converter={StaticResource Money}}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding AmountLimit, Converter={StaticResource Money}}" />
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
