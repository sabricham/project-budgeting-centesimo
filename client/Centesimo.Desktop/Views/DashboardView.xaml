<UserControl x:Class="Centesimo.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Centesimo.Desktop.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,12">
                <ComboBox DockPanel.Dock="Right" Width="110" ItemsSource="{Binding Ranges}"
                          SelectedItem="{Binding SelectedRange}" />
                <TextBlock Text="Home" Style="{StaticResource H1}" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Background="#33E5556E"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Riga di indicatori: tutti derivati da endpoint esistenti (§2.11) -->
            <UniformGrid Columns="4" Margin="0,0,0,4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PATRIMONIO NETTO" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding NetWorth.Total, Converter={StaticResource Money}}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{Binding NetWorth.Total, Converter={StaticResource AmountToBrush}}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="{Binding NetWorth.Liabilities, StringFormat=debiti: {0:N2} EUR}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TOTALE CONTI" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TotalAssets, Converter={StaticResource Money}}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="esclusi debiti/prestiti" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="USCITE DEL MESE" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding MonthSpending, Converter={StaticResource Money}}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{StaticResource NegativeBrush}" />
                        <TextBlock Text="trasferimenti esclusi" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENTRATE DEL MESE" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding MonthIncome, Converter={StaticResource Money}}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{StaticResource PositiveBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Andamento saldo" Style="{StaticResource H2}" />
                        <controls:LineChart Height="180" ItemsSource="{Binding BalanceSeries}"
                                            Stroke="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Andamento patrimonio netto" Style="{StaticResource H2}" />
                        <controls:LineChart Height="180" ItemsSource="{Binding NetWorthSeries}"
                                            Stroke="{StaticResource PositiveBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Widget budget: riusa GET /budgets, che restituisce già speso e residuo -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Budget del mese" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Budgets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Remaining, StringFormat=restano {0:N2} EUR}"
                                                       Foreground="{Binding OverBudget, Converter={StaticResource OverBudgetToBrush}}" />
                                            <TextBlock Text="{Binding CategoryName}" />
                                        </DockPanel>
                                        <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding UsagePercent, Mode=OneWay}"
                                                     Foreground="{Binding OverBudget, Converter={StaticResource OverBudgetToBrush}}"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     BorderThickness="0" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                                            <Run Text="{Binding SpentThisMonth, Converter={StaticResource Money}}" />
                                            <Run Text=" su " />
                                            <Run Text="{Binding AmountLimit, Converter={StaticResource Money}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Widget "prossime spese in arrivo": occorrenze projected (§2.7) -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="In arrivo (30 giorni)" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Upcoming}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Conferma" Padding="8,3"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.ConfirmUpcomingCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Width="90" TextAlignment="Right"
                                                   Text="{Binding Amount, Converter={StaticResource Money}}" Margin="0,0,10,0" />
                                        <TextBlock Width="80" Style="{StaticResource Muted}"
                                                   Text="{Binding Date, StringFormat={}{0:dd/MM}}" />
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Conti" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Right" Width="120" TextAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding Balance, Converter={StaticResource Money}}" />
                                    <TextBlock DockPanel.Dock="Right" Width="150" Style="{StaticResource Muted}"
                                               Text="{Binding TypeLabel}" />
                                    <TextBlock Text="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
