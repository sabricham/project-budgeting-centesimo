<Window x:Class="Centesimo.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centesimo"
        Height="820" Width="1280"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigazione (§2.12) -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,20,12,16">
                    <!-- Ingranaggio: glifo "Setting" di Segoe MDL2 Assets -->
                    <Button DockPanel.Dock="Right" Content="&#xE713;" VerticalAlignment="Top"
                            Style="{StaticResource IconButton}" ToolTip="Impostazioni"
                            Click="Settings_Click" />
                    <StackPanel>
                        <TextBlock Text="Centesimo" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UserLabel}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Content="Aggiorna" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                    <Button Content="Esci" Style="{StaticResource GhostButton}" Click="Logout_Click" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                         Background="Transparent" BorderThickness="0" Margin="8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource SurfaceAltBrush}" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="22" FontSize="14" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pagina corrente: la vista è scelta dai DataTemplate in App.xaml -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />

            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24,16"
                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,6"
                    Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Caricamento…" Style="{StaticResource Muted}" />
            </Border>
        </Grid>
    </Grid>
</Window>
