<UserControl x:Class="MoneyApp.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Conti" Style="{StaticResource H1}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E5556E"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Colonna sinistra: elenco conti + creazione conto + trasferimento -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="I tuoi conti" Style="{StaticResource H2}" />
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="330">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel MinWidth="280" Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                   Text="{Binding Balance, StringFormat={}{0:N2} €}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nuovo conto" Style="{StaticResource H2}" />
                        <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nome del conto" />
                        <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}" />
                        <TextBox Text="{Binding AccountInitialBalance, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Saldo iniziale" />
                        <Button Content="Crea conto" Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                </Border>

                <!-- Trasferimento: non è né entrata né uscita (§2.3) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Trasferimento fra conti" Style="{StaticResource H2}" />
                        <TextBlock Text="Sposta denaro senza falsare i report di spesa."
                                   Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding TransferFrom}"
                                  DisplayMemberPath="Name" />
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding TransferTo}"
                                  DisplayMemberPath="Name" />
                        <TextBox Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Importo" />
                        <DatePicker SelectedDate="{Binding TransferDate}" />
                        <Button Content="Trasferisci" Command="{Binding AddTransferCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Colonna destra: dettaglio del conto selezionato -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Archivia conto" Style="{StaticResource GhostButton}"
                                Command="{Binding ArchiveAccountCommand}"
                                CommandParameter="{Binding SelectedAccount}" />
                        <TextBlock Text="{Binding SelectedAccount.Name}" Style="{StaticResource H2}" />
                    </DockPanel>

                    <!-- Nuova transazione -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Importo" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Categoria" Style="{StaticResource Muted}" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding NewCategory}"
                                      DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Data" Style="{StaticResource Muted}" />
                            <DatePicker SelectedDate="{Binding NewDate}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom">
                            <CheckBox Content="Uscita" IsChecked="{Binding NewIsExpense}" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,8,0"
                                 Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Descrizione (facoltativa)" />
                        <Button Grid.Row="1" Grid.Column="3" Content="Aggiungi"
                                Command="{Binding AddTransactionCommand}" />
                    </Grid>

                    <!-- Debiti/prestiti: qui si aggiorna il residuo, non si registrano rate (§2.10) -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding SelectedAccount.IsLiability, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Aggiorna capitale residuo" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="La rata pagata va registrata come spesa dal conto corrente; qui si registra solo il residuo dell'estratto conto." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="140" Margin="0,0,8,0"
                                     Text="{Binding ResidualAmount, UpdateSourceTrigger=PropertyChanged}" />
                            <DatePicker SelectedDate="{Binding ResidualDate}" Margin="0,0,8,0" />
                            <Button Content="Registra residuo" Command="{Binding UpdateResidualCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Movimenti" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Transactions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Width="90"
                                                Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Categoria" Width="160" Binding="{Binding CategoryName}" />
                            <DataGridTextColumn Header="Descrizione" Width="*" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Stato" Width="90" Binding="{Binding Status}" />
                            <DataGridTemplateColumn Header="Importo" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Right" Margin="0,0,8,0"
                                                   Text="{Binding SignedAmount, StringFormat={}{0:N2} €}"
                                                   Foreground="{Binding SignedAmount, Converter={StaticResource AmountToBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Elimina" Padding="6,2" FontSize="11"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.DeleteTransactionCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
