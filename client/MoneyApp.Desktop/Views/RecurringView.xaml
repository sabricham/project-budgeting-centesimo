<UserControl x:Class="MoneyApp.Desktop.Views.RecurringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Abbonamenti e spese ricorrenti"
                   Style="{StaticResource H1}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E5556E"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Nuova ricorrenza" Style="{StaticResource H2}" />

                    <TextBlock Text="Conto" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding NewAccount}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="Categoria" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding NewCategory}"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock Text="Descrizione" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Importo" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Frequenza" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding NewFrequency}" />

                    <TextBlock Text="{Binding DaysHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NewDays, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Ogni N periodi" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding NewInterval, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Prima scadenza" Style="{StaticResource Muted}" />
                    <DatePicker SelectedDate="{Binding NewStartDate}" />

                    <CheckBox Content="Conferma automatica (importo fisso)" IsChecked="{Binding NewAutoConfirm}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Senza conferma automatica l'occorrenza resta in attesa: utile per bollette a importo variabile." />

                    <Button Content="Crea ricorrenza" Command="{Binding AddRecurringCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ricorrenze attive" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descrizione" Width="*" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Conto" Width="120" Binding="{Binding AccountName}" />
                            <DataGridTextColumn Header="Frequenza" Width="110" Binding="{Binding Frequency}" />
                            <DataGridTextColumn Header="Prossima" Width="100"
                                                Binding="{Binding NextOccurrence, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Importo" Width="100"
                                                Binding="{Binding Amount, StringFormat={}{0:N2} €}" />
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Disattiva" Padding="6,2" FontSize="11"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.DeleteRecurringCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Occorrenze in attesa di conferma" Style="{StaticResource H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Importo corretto (facoltativo):" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="120" Margin="0"
                                     Text="{Binding ConfirmAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Upcoming}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Width="100"
                                                Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Descrizione" Width="*" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Importo" Width="100"
                                                Binding="{Binding Amount, StringFormat={}{0:N2} €}" />
                            <DataGridTemplateColumn Header="" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Conferma" Padding="6,2" FontSize="11" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ConfirmOccurrenceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Salta" Padding="6,2" FontSize="11"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.SkipOccurrenceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
