<UserControl x:Class="MoneyApp.Desktop.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Obiettivi di risparmio" Style="{StaticResource H1}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E5556E"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top"
                Margin="0,0,16,12">
            <StackPanel>
                <TextBlock Text="Nuovo obiettivo" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Va collegato a un conto di tipo 'Risparmio'. Il progresso è il saldo di quel conto: per farlo crescere basta un trasferimento dalla pagina Conti." />
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome obiettivo" />
                <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="Importo target" />
                <DatePicker SelectedDate="{Binding NewTargetDate}" ToolTip="Scadenza (facoltativa)" />
                <ComboBox ItemsSource="{Binding SavingsAccounts}" SelectedItem="{Binding NewAccount}"
                          DisplayMemberPath="Name" />
                <Button Content="Crea obiettivo" Command="{Binding AddGoalCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Goals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Elimina" Padding="6,2" FontSize="11"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.DeleteGoalCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                </DockPanel>

                                <ProgressBar Height="10" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Foreground="{StaticResource PositiveBrush}"
                                             Background="{StaticResource SurfaceAltBrush}" BorderThickness="0" />

                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right">
                                        <Run Text="{Binding CurrentAmount, StringFormat={}{0:N2} €}" />
                                        <Run Text=" / " Foreground="#FF9AA3B2" />
                                        <Run Text="{Binding TargetAmount, StringFormat={}{0:N2} €}" Foreground="#FF9AA3B2" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding LinkedAccountName}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           Text="{Binding MonthlyRequired, StringFormat=Per arrivare in tempo: {0:N2} € al mese}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{Binding TargetDate, StringFormat=Scadenza: {0:dd/MM/yyyy}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
