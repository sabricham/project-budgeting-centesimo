# Copia questo file in `.env` (stessa cartella del docker-compose.yml).
# ATTENZIONE: qui NON vanno password o chiavi — quelle stanno in ./secrets/*.txt.

POSTGRES_DB=money
POSTGRES_USER=money_app

# Valuta base usata per aggregare i report (§2.8, conversione solo in aggregazione).
BASE_CURRENCY=EUR

# Fuso orario del container: influenza solo l'orario di esecuzione dei job schedulati.
# I dati restano sempre in UTC sul filo (§1.3).
TZ=Europe/Rome

# Durata dei token (§1.1).
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Provider prezzi di mercato: twelvedata | alphavantage | none
# Con `none` (o senza chiave in ./secrets/market_data_api_key.txt) il portafoglio
# funziona comunque: i prezzi si inseriscono a mano da PUT /api/v1/portfolio/prices/{ticker}.
MARKET_DATA_PROVIDER=twelvedata

# Metti a false per avviare l'API senza job schedulati (utile nei test).
RUN_SCHEDULER=true

LOG_LEVEL=info

# --- Certificato self-signed -------------------------------------------------
# Nomi per cui il certificato è valido, oltre a localhost/127.0.0.1.
# Su deploy locale lascia vuoto; sul server di rete metti il suo IP/hostname:
#   CERT_CN=192.168.1.104
#   CERT_EXTRA_SAN=IP:192.168.1.104,DNS:office
# Cambiarli DOPO il primo avvio non ha effetto: il certificato non viene
# rigenerato finché esistono server/certs/server.crt e server.key.
CERT_CN=localhost
CERT_EXTRA_SAN=
