<UserControl x:Class="Centesimo.Desktop.Views.PortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Centesimo.Desktop.Controls">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Intestazione: titolo a sinistra, conto e periodo a destra -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                      ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                      ctrl:Hint.Text="Periodo" />
            <ComboBox DockPanel.Dock="Right" Width="220"
                      ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount}"
                      DisplayMemberPath="Name" ctrl:Hint.Text="Conto" />
            <TextBlock Text="Investimenti" Style="{StaticResource H1}" />
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E5556E"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#33E0A63C"
                Visibility="{Binding MissingPricesWarning, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding MissingPricesWarning}" TextWrapping="Wrap" />
        </Border>

        <!-- Colonna sinistra: riepilogo e maschere di inserimento -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" Margin="0,0,16,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{Binding ValueModeLabel}"
                                    Style="{StaticResource GhostButton}" Padding="12,4"
                                    Command="{Binding ToggleValueModeCommand}"
                                    ToolTip="Alterna fra valori assoluti e percentuali" />
                            <TextBlock Text="Riepilogo" Style="{StaticResource H2}" Margin="0" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Summary.CashBalance, Converter={StaticResource Money}}" />
                            <TextBlock Text="Liquidità" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Summary.HoldingsValue, Converter={StaticResource Money}}" />
                            <TextBlock Text="Valore posizioni" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                       Text="{Binding Summary.TotalValue, Converter={StaticResource Money}}" />
                            <TextBlock Text="Totale" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UnrealizedDisplay}"
                                       Foreground="{Binding UnrealizedSign, Converter={StaticResource AmountToBrush}}" />
                            <TextBlock Text="Plus/minus non realizzata" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RealizedDisplay}"
                                       Foreground="{Binding RealizedSign, Converter={StaticResource AmountToBrush}}" />
                            <TextBlock Text="Plus/minus realizzata" Style="{StaticResource Muted}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nuova operazione" Style="{StaticResource H2}" />

                        <ComboBox ItemsSource="{Binding WritableAccounts}"
                                  SelectedItem="{Binding OperationAccount}"
                                  DisplayMemberPath="Name" ctrl:Hint.Text="Conto" />

                        <ComboBox ItemsSource="{Binding OperationTypes}" SelectedItem="{Binding OperationType}"
                                  ctrl:Hint.Text="Tipo di operazione" />

                        <TextBox Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Ticker" />

                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Quantità" />

                        <TextBox Text="{Binding PricePerShare, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Prezzo per azione" />

                        <TextBox Text="{Binding DividendAmount, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Importo dividendo"
                                 Visibility="{Binding IsDividend, Converter={StaticResource BoolToVisibility}}" />

                        <TextBox Text="{Binding Fees, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Commissioni del broker" />

                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding OperationCurrency}"
                                  DisplayMemberPath="DisplayName" ctrl:Hint.Text="Valuta" />

                        <DatePicker SelectedDate="{Binding OperationDate}" ctrl:Hint.Text="Data" />

                        <Button Content="Registra operazione" Command="{Binding AddOperationCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Prezzo manuale" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Serve per i titoli che il provider non copre: gli altri li aggiorna il job una volta al giorno." />
                        <TextBox Text="{Binding PriceTicker, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Ticker" />
                        <TextBox Text="{Binding PriceValue, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Hint.Text="Prezzo" />
                        <Button Content="Aggiorna prezzo" Command="{Binding SetPriceCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Colonna destra: interruttore di vista, grafico, tabella -->
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Interruttore a tutta larghezza: due metà, quella attiva in evidenza -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="3" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Posizioni" Padding="10,8"
                            Command="{Binding ShowPositionsViewCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPositions}" Value="False">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="Operazioni" Padding="10,8"
                            Command="{Binding ShowOperationsViewCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowOperations}" Value="False">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}"
                               Style="{StaticResource H2}" />
                    <ctrl:LineChart ItemsSource="{Binding ChartPoints}"
                                    Stroke="{StaticResource AccentBrush}" />
                </DockPanel>
            </Border>

            <!-- Posizioni -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Visibility="{Binding ShowPositions, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding Holdings}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticker" Width="90" Binding="{Binding Ticker}" />
                        <DataGridTextColumn Header="Conto" Width="130" Binding="{Binding AccountName}" />
                        <DataGridTextColumn Header="Quantità" Width="110"
                                            Binding="{Binding Quantity, Converter={StaticResource Quantity}}" />
                        <DataGridTextColumn Header="Carico medio" Width="130"
                                            Binding="{Binding AvgCostBasis, Converter={StaticResource Money}}" />
                        <DataGridTextColumn Header="Ultimo prezzo" Width="130"
                                            Binding="{Binding LastPrice, Converter={StaticResource Money}}" />
                        <DataGridTextColumn Header="Valore" Width="130"
                                            Binding="{Binding MarketValue, Converter={StaticResource Money}}" />
                        <DataGridTemplateColumn Header="P/L" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,8,0"
                                               Text="{Binding UnrealizedPnl, Converter={StaticResource Money}}"
                                               Foreground="{Binding UnrealizedPnl, Converter={StaticResource AmountToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Operazioni -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Visibility="{Binding ShowOperations, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding Operations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Width="100"
                                            Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                        <DataGridTextColumn Header="Conto" Width="130" Binding="{Binding AccountName}" />
                        <DataGridTextColumn Header="Tipo" Width="80" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Ticker" Width="90" Binding="{Binding Ticker}" />
                        <DataGridTextColumn Header="Quantità" Width="110"
                                            Binding="{Binding Quantity, Converter={StaticResource Quantity}}" />
                        <DataGridTextColumn Header="Prezzo" Width="120"
                                            Binding="{Binding PricePerShare, Converter={StaticResource Money}}" />
                        <DataGridTextColumn Header="Commissioni" Width="120"
                                            Binding="{Binding Fees, Converter={StaticResource Money}}" />
                        <DataGridTextColumn Header="Effetto cassa" Width="*"
                                            Binding="{Binding CashDelta, Converter={StaticResource Money}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
