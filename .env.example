# Copia questo file in `.env`, nella stessa cartella del docker-compose.yml.
# ATTENZIONE: qui NON vanno password né chiavi — quelle stanno in ./secrets/*.txt.

POSTGRES_DB=centesimo
POSTGRES_USER=centesimo

# Porta sull'host da cui si raggiunge il sito, e che Tailscale pubblica su internet.
WEB_PORT=8080

BASE_CURRENCY=EUR
TZ=Europe/Rome

# Durata dei token. L'access token è breve, il refresh lungo: il rinnovo è automatico.
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Limite di tentativi di accesso per indirizzo. L'applicazione è raggiungibile da
# internet: abbassarli stringe la difesa, alzarli la allenta.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

LOG_LEVEL=info
